{
  "name": "cigu-theme",
  "version": "1.0.0",
  "description": "Tema personalizado CIGU UNAM",
  "main": "index.js",
  "scripts": {
    "prepare": "husky",
    "lint:php": "php -l"
  },
  "lint-staged": {
    "*.php": [
      "php -l"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "subject-case": [0],
      "header-max-length": [2, "always", 300]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/piaramirez/cigu_layout.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/piaramirez/cigu_layout/issues"
  },
  "homepage": "https://github.com/piaramirez/cigu_layout#readme",
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1"
  }
}